{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ROAR-NET API Generator",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        // The playground is the workspace of the Extension Development Host.
        "${workspaceFolder}/playground",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode-extension/dist/**/*.js"],
      "preLaunchTask": "watch-generator"
    }
  ]
}
